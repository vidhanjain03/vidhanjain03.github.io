{%- set nav = [
  { url: "/blog/",     label: "Blog",     icon: "📝" },
  { url: "/research/", label: "Research", icon: "🔬" },
  { url: "/projects/", label: "Projects", icon: "🛠️" },
  { url: "/photos/",   label: "Photos",   icon: "📷" },
  { url: "/me/",       label: "About me", icon: "👋" }
] -%}
<aside class="sidebar" id="sidebar">
  <div class="sidebar-top">
    <a class="brand" href="/" aria-label="Home">
      <img src="/favicon.svg" alt="" width="26" height="26">
      <span>{{ site.domain }}</span>
    </a>
    <div class="sidebar-controls">
      <button class="accent-dot" type="button" aria-label="Change accent color" title="Change accent color"></button>
      <button class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
        <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="sidebar-body">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>

  <div class="sidebar-body" id="sidebar-body">
    <p class="sidebar-intro">{{ site.sidebarIntro | safe }} <span aria-hidden="true">🌱</span></p>

    <nav class="nav" aria-label="Main">
      {%- for item in nav %}
      <a href="{{ item.url }}" class="nav-link{% if page.url.startsWith(item.url) %} active{% endif %}"{% if page.url.startsWith(item.url) %} aria-current="page"{% endif %}>
        <span class="nav-icon" aria-hidden="true">{{ item.icon }}</span>{{ item.label }}
      </a>
      {%- endfor %}
    </nav>

    <div class="sidebar-bottom">
      <div class="social">
        <a href="mailto:{{ site.email }}" aria-label="Email" title="Email">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6 8.5 7 8.5-7"/></svg>
        </a>
        <a href="{{ site.github }}" aria-label="GitHub" title="GitHub" rel="me">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/></svg>
        </a>
        <a href="{{ site.linkedin }}" aria-label="LinkedIn" title="LinkedIn" rel="me">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7"/></svg>
        </a>
        <a href="/feed.xml" aria-label="RSS feed" title="RSS feed">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M5 11a8 8 0 0 1 8 8M5 5a14 14 0 0 1 14 14"/><circle cx="6" cy="18" r="1.3" fill="currentColor"/></svg>
        </a>
      </div>
      <div class="sidebar-links">
        <a href="{{ site.resume }}">Resume</a>
        <span aria-hidden="true">|</span>
        <a href="/topics/">Topics</a>
        <span aria-hidden="true">|</span>
        <a href="/now/">Now</a>
      </div>
    </div>
  </div>
</aside>
